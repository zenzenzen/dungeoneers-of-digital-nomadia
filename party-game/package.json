{
  "name": "digital-nomadia-party-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "catalogue": "python3 scripts/catalogue.py",
    "content:check": "tsx scripts/content-check.ts",
    "prompts": "tsx scripts/export-prompts.ts",
    "art:prepare": "node scripts/prepare-monster-art.mjs",
    "art:check": "node scripts/prepare-monster-art.mjs --check",
    "dev": "npm run build && tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run content:check && tsc --noEmit && npm test",
    "backup": "tsx scripts/database.ts backup",
    "restore": "tsx scripts/database.ts restore",
    "serve": "node scripts/runtime.mjs serve",
    "stop": "node scripts/runtime.mjs stop",
    "reset": "node scripts/runtime.mjs reset",
    "setup": "npm ci && npm run build",
    "content:build": "tsx scripts/seed-content.ts && npm run prompts"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "10.1.5",
    "fastify": "5.12.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
